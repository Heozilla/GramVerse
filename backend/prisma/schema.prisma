// GramVerse – Prisma 7 + PostgreSQL (@prisma/adapter-pg)
// Datasource URL được khai báo trong prisma.config.js (chuẩn Prisma 7).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ════════════════════════════════════════════════════════════
// ENUMS
// ════════════════════════════════════════════════════════════

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  PENDING
  BANNED
}

enum Language {
  vi
  en
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContentSource {
  MANUAL
  AI_GENERATED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum CefrLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum QuestionType {
  MULTIPLE_CHOICE
  FILL_BLANK
  ERROR_CORRECTION
  REORDER
}

enum RelationType {
  PREREQUISITE // phải học source trước target
  RELATED
  EXTENDS
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum PartOfSpeech {
  NOUN
  PRONOUN
  VERB
  ADJECTIVE
  ADVERB
  PREPOSITION
  CONJUNCTION
  INTERJECTION
  DETERMINER
  PHRASAL_VERB
}

enum VocabSetCategory {
  TOPIC
  TOEIC
  ACADEMIC
}

enum IpaType {
  MONOPHTHONG
  DIPHTHONG
  CONSONANT
}

enum AiTaskType {
  EXPLAIN_QUESTION
  ANALYZE_SENTENCE
  GRADE_WRITING
  GENERATE_LESSON
  GENERATE_VOCAB
}

// ════════════════════════════════════════════════════════════
// 1. AUTH & HỆ THỐNG
// ════════════════════════════════════════════════════════════

model User {
  id             Int        @id @default(autoincrement())
  email          String     @unique
  passwordHash   String?    @map("password_hash") // null nếu chỉ đăng nhập Google
  googleId       String?    @unique @map("google_id")
  fullName       String     @map("full_name")
  avatarUrl      String?    @map("avatar_url")
  role           Role       @default(USER)
  status         UserStatus @default(ACTIVE)
  preferredLang  Language   @default(vi) @map("preferred_lang")
  xp             Int        @default(0)
  level          Int        @default(1)
  streak         Int        @default(0)
  longestStreak  Int        @default(0) @map("longest_streak")
  lastActiveAt   DateTime?  @map("last_active_at")
  aiCallsToday   Int        @default(0) @map("ai_calls_today")
  aiCallsResetAt DateTime?  @map("ai_calls_reset_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  sessions          LoginSession[]
  resetTokens       PasswordResetToken[]
  activityLogs      ActivityLog[]
  lessonProgress    UserLessonProgress[]
  questionAttempts  QuestionAttempt[]
  vocabSrs          UserVocabSrs[]
  writingSubmission WritingSubmission[]

  @@map("users")
}

model LoginSession {
  id               Int       @id @default(autoincrement())
  userId           Int       @map("user_id")
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("login_sessions")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model ActivityLog {
  id         BigInt   @id @default(autoincrement())
  userId     Int?     @map("user_id")
  action     String // VD: LESSON_COMPLETED, QUIZ_SUBMITTED, WORD_REVIEWED, AI_EXPLAIN
  entityType String?  @map("entity_type")
  entityId   Int?     @map("entity_id")
  xpEarned   Int      @default(0) @map("xp_earned")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action])
  @@map("activity_logs")
}

model SystemSetting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// ════════════════════════════════════════════════════════════
// 2. GRAMMAR UNIVERSE  (BEGIN → Galaxy → Planet → Zone)
// ════════════════════════════════════════════════════════════

/// Tầng 1 – Thiên hà (Foundation / Structure / Mastery)
model GrammarCategory {
  id            Int      @id @default(autoincrement())
  slug          String   @unique
  nameVi        String   @map("name_vi")
  nameEn        String   @map("name_en")
  descriptionVi String?  @map("description_vi")
  descriptionEn String?  @map("description_en")
  color         String
  icon          String? // tên icon lucide-react
  orderIndex    Int      @map("order_index")
  nodeX         Float    @default(0) @map("node_x")
  nodeY         Float    @default(0) @map("node_y")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  topics GrammarTopic[]

  @@map("grammar_categories")
}

/// Tầng 2 – Hành tinh (12 chủ đề ngữ pháp), có tọa độ node cho ECharts graph
model GrammarTopic {
  id            Int           @id @default(autoincrement())
  categoryId    Int           @map("category_id")
  slug          String        @unique
  nameVi        String        @map("name_vi")
  nameEn        String        @map("name_en")
  descriptionVi String?       @map("description_vi")
  descriptionEn String?       @map("description_en")
  color         String
  icon          String?
  orderIndex    Int           @map("order_index")
  nodeX         Float         @default(0) @map("node_x")
  nodeY         Float         @default(0) @map("node_y")
  nodeSize      Int           @default(60) @map("node_size")
  status        ContentStatus @default(PUBLISHED)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  category        GrammarCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  lessons         Lesson[]
  outgoing        TopicRelationship[] @relation("RelSource")
  incoming        TopicRelationship[] @relation("RelTarget")
  readingPassages ReadingPassage[]
  writingPrompts  WritingPrompt[]

  @@index([categoryId])
  @@map("grammar_topics")
}

/// Cạnh nối giữa các hành tinh trên bản đồ vũ trụ
model TopicRelationship {
  id            Int          @id @default(autoincrement())
  sourceTopicId Int          @map("source_topic_id")
  targetTopicId Int          @map("target_topic_id")
  relationType  RelationType @default(RELATED) @map("relation_type")
  labelVi       String?      @map("label_vi")
  labelEn       String?      @map("label_en")

  source GrammarTopic @relation("RelSource", fields: [sourceTopicId], references: [id], onDelete: Cascade)
  target GrammarTopic @relation("RelTarget", fields: [targetTopicId], references: [id], onDelete: Cascade)

  @@unique([sourceTopicId, targetTopicId])
  @@map("topic_relationships")
}

/// Tầng 3 – Khu vực (bài học con): lý thuyết song ngữ + ví dụ + bài tập
model Lesson {
  id             Int           @id @default(autoincrement())
  topicId        Int           @map("topic_id")
  slug           String
  titleVi        String        @map("title_vi")
  titleEn        String        @map("title_en")
  summaryVi      String        @map("summary_vi")
  summaryEn      String        @map("summary_en")
  theoryVi       String        @map("theory_vi") @db.Text
  theoryEn       String        @map("theory_en") @db.Text
  formula        String? // VD: "S + V(s/es) + O"
  /// [{ en, vi, highlight: string[] }] – highlight là các chuỗi con của en cần tô màu
  examples       Json          @default("[]")
  tipVi          String?       @map("tip_vi")
  tipEn          String?       @map("tip_en")
  /// [{ wrong, right, noteVi }]
  commonMistakes Json?         @map("common_mistakes")
  orderIndex     Int           @map("order_index")
  difficulty     Difficulty    @default(EASY)
  xpReward       Int           @default(20) @map("xp_reward")
  status         ContentStatus @default(PUBLISHED)
  source         ContentSource @default(MANUAL)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  topic     GrammarTopic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  questions Question[]
  progress  UserLessonProgress[]
  posWords  Word[]               @relation("WordPosLesson")

  @@unique([topicId, slug])
  @@index([topicId, orderIndex])
  @@map("lessons")
}

model Question {
  id                Int           @id @default(autoincrement())
  lessonId          Int           @map("lesson_id")
  type              QuestionType  @default(MULTIPLE_CHOICE)
  difficulty        Difficulty    @default(EASY)
  promptEn          String        @map("prompt_en")
  promptVi          String?       @map("prompt_vi")
  /// MULTIPLE_CHOICE: ["went", "go", ...]; REORDER: các mảnh từ
  options           Json?
  correctAnswer     String        @map("correct_answer")
  /// Các đáp án chấp nhận thêm cho FILL_BLANK / ERROR_CORRECTION
  acceptableAnswers Json?         @map("acceptable_answers")
  explanationVi     String        @map("explanation_vi")
  explanationEn     String?       @map("explanation_en")
  orderIndex        Int           @default(0) @map("order_index")
  status            ContentStatus @default(PUBLISHED)
  source            ContentSource @default(MANUAL)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  lesson   Lesson            @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  attempts QuestionAttempt[]
  aiCache  AiCache[]

  @@index([lessonId])
  @@map("questions")
}

model UserLessonProgress {
  id          Int            @id @default(autoincrement())
  userId      Int            @map("user_id")
  lessonId    Int            @map("lesson_id")
  status      ProgressStatus @default(NOT_STARTED)
  bestScore   Int            @default(0) @map("best_score") // 0–100
  attempts    Int            @default(0)
  completedAt DateTime?      @map("completed_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("user_lesson_progress")
}

model QuestionAttempt {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  questionId Int      @map("question_id")
  userAnswer String   @map("user_answer")
  isCorrect  Boolean  @map("is_correct")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([questionId])
  @@map("question_attempts")
}

// ════════════════════════════════════════════════════════════
// 3. VOCABULARY & SRS (SM-2)
// ════════════════════════════════════════════════════════════

model VocabSet {
  id            Int              @id @default(autoincrement())
  slug          String           @unique
  nameVi        String           @map("name_vi")
  nameEn        String           @map("name_en")
  descriptionVi String?          @map("description_vi")
  category      VocabSetCategory @default(TOPIC)
  level         CefrLevel        @default(A2)
  icon          String?
  color         String?
  orderIndex    Int              @default(0) @map("order_index")
  status        ContentStatus    @default(PUBLISHED)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  words Word[]

  @@map("vocab_sets")
}

model Word {
  id          Int           @id @default(autoincrement())
  setId       Int           @map("set_id")
  word        String
  ipa         String?
  pos         PartOfSpeech
  /// Liên kết tới Khu vực tương ứng trong hành tinh Parts of Speech
  posLessonId Int?          @map("pos_lesson_id")
  meaningVi   String        @map("meaning_vi")
  meaningEn   String?       @map("meaning_en")
  exampleEn   String?       @map("example_en")
  exampleVi   String?       @map("example_vi")
  audioUrl    String?       @map("audio_url")
  imageUrl    String?       @map("image_url")
  cefrLevel   CefrLevel?    @map("cefr_level")
  status      ContentStatus @default(PUBLISHED)
  source      ContentSource @default(MANUAL)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  set       VocabSet       @relation(fields: [setId], references: [id], onDelete: Cascade)
  posLesson Lesson?        @relation("WordPosLesson", fields: [posLessonId], references: [id], onDelete: SetNull)
  srs       UserVocabSrs[]

  @@unique([setId, word, pos])
  @@index([pos])
  @@map("words")
}

model UserVocabSrs {
  id             Int       @id @default(autoincrement())
  userId         Int       @map("user_id")
  wordId         Int       @map("word_id")
  easeFactor     Float     @default(2.5) @map("ease_factor")
  intervalDays   Int       @default(0) @map("interval_days")
  repetitions    Int       @default(0)
  lapses         Int       @default(0)
  lastQuality    Int?      @map("last_quality") // 0–5 theo SM-2
  nextReviewAt   DateTime  @default(now()) @map("next_review_at")
  lastReviewedAt DateTime? @map("last_reviewed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
  @@index([userId, nextReviewAt])
  @@map("user_vocab_srs")
}

// ════════════════════════════════════════════════════════════
// 4. PRONUNCIATION (IPA)
// ════════════════════════════════════════════════════════════

model IpaSound {
  id              Int     @id @default(autoincrement())
  symbol          String  @unique
  type            IpaType
  descriptionVi   String? @map("description_vi")
  mouthPositionVi String? @map("mouth_position_vi")
  /// [{ word, ipa }]
  exampleWords    Json    @default("[]") @map("example_words")
  audioUrl        String? @map("audio_url")
  orderIndex      Int     @default(0) @map("order_index")

  @@map("ipa_sounds")
}

// ════════════════════════════════════════════════════════════
// 5. READING / WRITING + AI CACHE
// ════════════════════════════════════════════════════════════

model ReadingPassage {
  id             Int           @id @default(autoincrement())
  title          String
  content        String        @db.Text
  translationVi  String?       @map("translation_vi") @db.Text
  level          CefrLevel     @default(B1)
  grammarTopicId Int?          @map("grammar_topic_id")
  /// [{ question, options, answer, explanationVi }]
  questions      Json?
  wordCount      Int           @default(0) @map("word_count")
  status         ContentStatus @default(PUBLISHED)
  createdAt      DateTime      @default(now()) @map("created_at")

  grammarTopic GrammarTopic? @relation(fields: [grammarTopicId], references: [id], onDelete: SetNull)

  @@map("reading_passages")
}

model WritingPrompt {
  id             Int           @id @default(autoincrement())
  titleVi        String        @map("title_vi")
  promptEn       String        @map("prompt_en") @db.Text
  promptVi       String?       @map("prompt_vi") @db.Text
  level          CefrLevel     @default(B1)
  minWords       Int           @default(50) @map("min_words")
  maxWords       Int           @default(250) @map("max_words")
  grammarTopicId Int?          @map("grammar_topic_id")
  status         ContentStatus @default(PUBLISHED)
  createdAt      DateTime      @default(now()) @map("created_at")

  grammarTopic GrammarTopic?       @relation(fields: [grammarTopicId], references: [id], onDelete: SetNull)
  submissions  WritingSubmission[]

  @@map("writing_prompts")
}

model WritingSubmission {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  promptId        Int      @map("prompt_id")
  content         String   @db.Text
  overallScore    Float?   @map("overall_score")
  feedbackVi      String?  @map("feedback_vi") @db.Text
  improvedVersion String?  @map("improved_version") @db.Text
  /// [{ original, corrected, reasonVi, relatedTopicSlug }]
  corrections     Json?
  createdAt       DateTime @default(now()) @map("created_at")

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt WritingPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("writing_submissions")
}

/// Cache phản hồi Gemini theo hash của prompt để tiết kiệm quota
model AiCache {
  id         Int        @id @default(autoincrement())
  promptHash String     @unique @map("prompt_hash") // sha256(task + input chuẩn hóa)
  taskType   AiTaskType @map("task_type")
  questionId Int?       @map("question_id")
  model      String
  response   Json
  hitCount   Int        @default(0) @map("hit_count")
  createdAt  DateTime   @default(now()) @map("created_at")
  expiresAt  DateTime?  @map("expires_at")

  question Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([taskType])
  @@map("ai_cache")
}
