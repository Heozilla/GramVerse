DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gramverse?schema=public"
PORT=5000
NODE_ENV=development
# Origin của frontend được phép gọi API (phân tách bằng dấu phẩy)
CORS_ORIGINS="http://localhost:5173"
JWT_SECRET="change-me"
GEMINI_API_KEY=""
# Tài khoản admin được tạo bởi seed.js
SEED_ADMIN_EMAIL="admin@gramverse.local"
SEED_ADMIN_PASSWORD="change-me-admin"
